# BEGIN repo-baseline: gitignore
# Build output, packages and coverage reports
/artifacts/

# Temporary files of any kind, for people and agents alike
/tmp/

# Editor backup and lock files
~$*
*~

# .NET patterns, based on https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
BenchmarkDotNet.Artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet packages and symbol packages
*.nupkg
*.snupkg

# Coverage
CodeCoverage/

# MSBuild binary and structured logs
*.binlog

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml

# NUKE
.nuke/*
!.nuke/parameters.json

# User-specific project settings
*.user
# END repo-baseline: gitignore

# The release workflow scripts are sources, not build results. Must follow the shared [Rr]elease/ pattern.
!/.github/scripts/release/

.idea

# Signing key
Chaos.Mongo.snk

# Python bytecode caches of the tamper-evidence verifier tooling
__pycache__/
