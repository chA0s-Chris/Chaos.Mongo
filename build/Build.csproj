<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fallout evaluates projects with the MSBuild of an installed SDK that its own process can load. On
       net10.0 that is the .NET 10 SDK, whose MSBuild binds the NuGet.Frameworks version that Fallout 10.5.0
       resolves. On net11.0 it is the .NET 11 SDK, whose MSBuild needs a newer version, and evaluation fails.
       See https://github.com/Fallout-build/Fallout/issues/731.

       No target triggers this evaluation, so a clean log does not prove that it works. Check it directly with
       ProjectModelTasks.Initialize() and ParseProject when the target framework, Fallout or the .NET 10 SDK band
       changes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BuildPipeline</RootNamespace>
    <NoWarn>CS0649;CS0169;CA1050;CA1822;CA2211;IDE1006</NoWarn>
    <FalloutRootDirectory>..</FalloutRootDirectory>
    <FalloutScriptDirectory>..</FalloutScriptDirectory>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fallout.Common" />
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="SemanticVersioning" />
  </ItemGroup>

</Project>
