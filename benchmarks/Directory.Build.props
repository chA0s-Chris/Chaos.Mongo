<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>$(LatestTarget)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)../tests/MongoDbTestImages.cs'))" Link="MongoDbTestImages.cs" />
  </ItemGroup>
</Project>
