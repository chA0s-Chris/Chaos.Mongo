{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "addLabels": [
    "renovate",
    "skip-changelog"
  ],
  "major": {
    "dependencyDashboardApproval": true
  },
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/__fixtures__/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pick up the three pinned MongoDB test image tags in tests/MongoDbTestImages.cs.",
      "managerFilePatterns": [
        "/^tests/MongoDbTestImages\\.cs$/"
      ],
      "matchStrings": [
        "renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?) packageName=(?<packageName>.*?) versioning=(?<versioning>.*?)\\s*\\n\\s*public const String \\w+ = \"mongo:(?<currentValue>.*?)\";"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Hold the minimum-supported Mongo test image to the 7.0.x line.",
      "matchDepNames": [
        "mongo-minimum-supported"
      ],
      "allowedVersions": "/^7\\.0\\./"
    },
    {
      "description": "Hold the primary Mongo test image to the 8.0.x line.",
      "matchDepNames": [
        "mongo-primary"
      ],
      "allowedVersions": "/^8\\.0\\./"
    },
    {
      "description": "Restore old NuGet update behavior for bare versions",
      "matchManagers": [
        "nuget"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Hold the dependency minimums of the src/ packages (see Directory.Packages.props) for Dependency Dashboard approval. Vulnerability fixes still open pull requests.",
      "matchManagers": [
        "nuget"
      ],
      "matchPackageNames": [
        "Microsoft.Extensions.Configuration.Abstractions",
        "Microsoft.Extensions.Configuration.Binder",
        "Microsoft.Extensions.DependencyInjection",
        "Microsoft.Extensions.Hosting.Abstractions",
        "Microsoft.Extensions.Logging.Abstractions",
        "Microsoft.Extensions.Options",
        "Microsoft.Extensions.Options.ConfigurationExtensions",
        "MongoDB.Driver",
        "System.IO.Hashing",
        "System.Security.Cryptography.Pkcs"
      ],
      "groupName": "src dependency minimums",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Allow FluentAssertions updates within v7 only",
      "matchPackageNames": [
        "FluentAssertions"
      ],
      "allowedVersions": "<8"
    },
    {
      "groupName": "NUnit packages",
      "matchPackageNames": [
        "NUnit",
        "NUnit.Analyzers",
        "NUnit3TestAdapter"
      ]
    },
    {
      "groupName": "Test SDK",
      "matchPackageNames": [
        "Microsoft.NET.Test.Sdk",
        "Microsoft.TestPlatform.TestHost"
      ]
    }
  ]
}
