<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <Import Project="$(MSBuildThisFileDirectory)../.repo-baseline/Tests.props" />

  <PropertyGroup>
    <NoWarn>$(NoWarn);CS0618;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)MongoDbTestImages.cs" Link="MongoDbTestImages.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)IsolatedConventionTestProcess.cs" Link="IsolatedConventionTestProcess.cs" />
  </ItemGroup>

  <!-- Moq is not part of the shared test packages. Older tests still use it until they are migrated to
       hand-written test doubles (see tests/AGENTS.md). -->
  <ItemGroup>
    <PackageReference Include="Moq" />
  </ItemGroup>
</Project>
