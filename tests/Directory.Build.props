<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <Import Project="$(MSBuildThisFileDirectory)../.repo-baseline/Tests.props" />

  <PropertyGroup>
    <NoWarn>$(NoWarn);CS0618;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)MongoDbTestImages.cs" Link="MongoDbTestImages.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)IsolatedConventionTestProcess.cs"
             Link="IsolatedConventionTestProcess.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)SimultaneousCalls.cs" Link="SimultaneousCalls.cs" />
  </ItemGroup>

  <!-- Container and database helpers for the test projects that run against MongoDB; the build pipeline tests have
       neither Testcontainers nor the driver. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'BuildPipeline.Tests'">
    <Compile Include="$(MSBuildThisFileDirectory)ContainerStartDiagnostics.cs" Link="ContainerStartDiagnostics.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)TestDatabases.cs" Link="TestDatabases.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DropTestDatabasesAttribute.cs" Link="DropTestDatabasesAttribute.cs" />
  </ItemGroup>

  <!-- The implicit usings of .NET 11 include System.Net.Http.Json, those of .NET 10 do not. Importing it for every
       target framework keeps code cleanup, which removes the using as redundant under .NET 11, from breaking the
       .NET 10 build. -->
  <ItemGroup>
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>

  <!-- Moq is not part of the shared test packages. Older tests still use it until they are migrated to
       hand-written test doubles (see tests/AGENTS.md). -->
  <ItemGroup>
    <PackageReference Include="Moq" />
  </ItemGroup>
</Project>
