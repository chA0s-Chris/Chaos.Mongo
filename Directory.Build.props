<Project>
  <PropertyGroup>
    <LatestTarget>net10.0</LatestTarget>
    <MainTargets>$(LatestTarget)</MainTargets>
    <TargetFrameworks>$(MainTargets)</TargetFrameworks>

    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>

    <NoWarn>1591</NoWarn>
    <PreferredUILang>en</PreferredUILang>
  </PropertyGroup>

  <!-- Strong naming: ordinary builds are public-signed with the committed public key, so every
       build carries the released identity (PublicKeyToken=258e5594a5dc8a36). Only the Nuke Pack
       target signs fully; it overrides PublicSign and AssemblyOriginatorKeyFile with the private key. -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Chaos.Mongo.Public.snk</AssemblyOriginatorKeyFile>
    <!-- Contents of Chaos.Mongo.Public.snk. The SDK appends it to every InternalsVisibleTo item. -->
    <PublicKey></PublicKey>
  </PropertyGroup>
</Project>
